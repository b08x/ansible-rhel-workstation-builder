# SPDX-License-Identifier: MIT-0
# Dynamically generated blueprint for Fedora Workstation
# Generated by Ansible role: osbuild

name = "{{ blueprint_name }}"
description = "{{ blueprint_description }}"
version = "{{ blueprint_version }}"
distro = "{{ osbuild_distro }}"

# =============================================================================
# Package Groups
# =============================================================================

[[groups]]
name = "c-development"
[[groups]]
name = "headless-management"
[[groups]]
name = "development-tools"
[[groups]]
name = "container-management"
[[groups]]
name = "system-tools"
[[groups]]
name = "admin-tools"

# =============================================================================
# Core System Packages
# =============================================================================

[[packages]]
name = "bash"
version = "*"
[[packages]]
name = "coreutils"
version = "*"
[[packages]]
name = "bind-utils"
version = "*"

# Kernel packages
[[packages]]
name = "kernel"
version = "*"
[[packages]]
name = "kernel-devel"
version = "*"
[[packages]]
name = "kernel-headers"
version = "*"
[[packages]]
name = "kernel-modules"
version = "*"
[[packages]]
name = "kernel-modules-core"
version = "*"
[[packages]]
name = "kernel-modules-extra"
version = "*"
[[packages]]
name = "kernel-tools"
version = "*"
[[packages]]
name = "kernel-tools-libs"
version = "*"

# Anaconda installer
[[packages]]
name = "anaconda"
version = "*"
[[packages]]
name = "anaconda-gui"
version = "*"
[[packages]]
name = "anaconda-dracut"
version = "*"
[[packages]]
name = "dracut-live"
version = "*"
[[packages]]
name = "dracut-network"
version = "*"
[[packages]]
name = "dracut"
version = "*"

# System utilities
[[packages]]
name = "NetworkManager"
version = "*"
[[packages]]
name = "firewalld"
version = "*"
[[packages]]
name = "chrony"
version = "*"

# =============================================================================
# NVIDIA Driver & CUDA Stack (conditional)
# =============================================================================

{% if use_nvidia | bool %}
{% for package in osbuild_nvidia_packages %}
[[packages]]
name = "{{ package }}"
version = "*"
{% endfor %}
{% endif %}

# =============================================================================
# Desktop Environment - GNOME
# =============================================================================

[[packages]]
name = "gnome-shell"
version = "*"
[[packages]]
name = "gdm"
version = "*"

# =============================================================================
# Desktop Environment - Sway (conditional)
# =============================================================================

{% if use_sway | bool %}
{% for package in osbuild_sway_packages %}
[[packages]]
name = "{{ package }}"
version = "*"
{% endfor %}
{% endif %}

# =============================================================================
# Container Tools (conditional)
# =============================================================================

{% if include_container_tools | bool %}
{% for package in osbuild_container_packages %}
[[packages]]
name = "{{ package }}"
version = "*"
{% endfor %}
{% endif %}

# =============================================================================
# Intel oneAPI (conditional - image-time installation)
# =============================================================================

{% if include_oneapi_in_image | bool %}
{% for package in osbuild_oneapi_packages %}
[[packages]]
name = "{{ package }}"
version = "*"
{% endfor %}
{% endif %}

# =============================================================================
# Extra Packages
# =============================================================================

{% for package in osbuild_extra_packages %}
[[packages]]
name = "{{ package }}"
version = "*"
{% endfor %}

# =============================================================================
# Kernel Arguments
# =============================================================================

[customizations.kernel]
{% if use_nvidia | bool %}
append = "{{ osbuild_nvidia_kernel_args }}"
{% endif %}

# =============================================================================
# Services
# =============================================================================

[customizations.services]
enabled = [
{% for service in osbuild_enabled_services %}
  "{{ service }}",
{% endfor %}
{% if use_nvidia | bool %}
{% for service in osbuild_nvidia_services %}
  "{{ service }}",
{% endfor %}
{% endif %}
  "custom-first-boot"
]

# =============================================================================
# Timezone & Locale
# =============================================================================

[customizations.timezone]
timezone = "{{ osbuild_timezone }}"

[customizations.locale]
languages = ["{{ osbuild_locale }}"]
keyboard = "{{ osbuild_keyboard }}"

# =============================================================================
# User Configuration
# =============================================================================

[[customizations.user]]
name = "{{ osbuild_user_name }}"
description = "{{ osbuild_user_description }}"
password = "{{ osbuild_user_password }}"
groups = {{ osbuild_user_groups | to_json }}
shell = "/usr/bin/zsh"

[[customizations.files]]
path = "/etc/sudoers.d/99-user"
data = "{{ osbuild_user_name }} ALL=(ALL) NOPASSWD: ALL"
mode = "0440"

# =============================================================================
# NVIDIA CDI Service (conditional)
# =============================================================================

{% if use_nvidia | bool %}
[[customizations.files]]
path = "/usr/local/bin/nvidia-cdi-generate.sh"
mode = "0755"
data = """
#!/bin/bash
set -euo pipefail
timeout=30
while [ $timeout -gt 0 ]; do
  if [ -e /dev/nvidia0 ]; then
    mkdir -p /etc/cdi
    nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
    exit 0
  fi
  sleep 1
  ((timeout--))
done
exit 1
"""

[[customizations.files]]
path = "/etc/systemd/system/nvidia-cdi-refresh.service"
data = """
[Unit]
Description=Generate NVIDIA CDI specification for Podman
After=custom-first-boot.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nvidia-cdi-generate.sh

[Install]
WantedBy=multi-user.target
"""
{% endif %}
