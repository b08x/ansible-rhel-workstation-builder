#!/bin/bash
# ============================================================================
# images.sh - KIWI Post-Create Image Customization Script
# ============================================================================
# This script executes after the root tree is created but before ISO packaging
# Generated by Ansible kiwi role
# Ansible managed - DO NOT EDIT MANUALLY
# ============================================================================

set -euxo pipefail

# Source KIWI environment
test -f /.kconfig && . /.kconfig
test -f /.profile && . /.profile

echo "============================================================================"
echo "KIWI Post-Create Image Customization"
echo "Image: {{ kiwi_image_name }}"
echo "============================================================================"

# ============================================================================
# 1. Dracut Configuration for Live ISO
# ============================================================================

echo "[+] Configuring dracut for live ISO..."

# Create dracut configuration for live system
cat > /etc/dracut.conf.d/02-livecd.conf << 'DRACUT_EOF'
# Live CD dracut configuration
add_dracutmodules+=" dmsquash-live pollcdrom "
omit_dracutmodules+=" plymouth "
hostonly="no"
hostonly_cmdline="no"
DRACUT_EOF

echo "  - Created /etc/dracut.conf.d/02-livecd.conf"

{% if kiwi_enable_nvidia %}
# Add NVIDIA modules to dracut
cat > /etc/dracut.conf.d/03-nvidia.conf << 'NVIDIA_DRACUT_EOF'
# NVIDIA driver modules
add_drivers+=" nvidia nvidia_modeset nvidia_uvm nvidia_drm "
install_items+=" /usr/bin/nvidia-modprobe "
NVIDIA_DRACUT_EOF

echo "  - Created /etc/dracut.conf.d/03-nvidia.conf"
{% endif %}

# ============================================================================
# 2. Grub Customization
# ============================================================================

echo "[+] Customizing GRUB configuration..."

# Update GRUB theme for branding
if [ -d /boot/grub2/themes ]; then
    # Set timeout and default boot parameters
    cat >> /etc/default/grub << 'GRUB_EOF'

# Custom boot parameters for live ISO
GRUB_TIMEOUT={{ kiwi_bootloader_timeout }}
GRUB_TIMEOUT_STYLE=menu
GRUB_TERMINAL_OUTPUT="{{ kiwi_bootloader_console }}"
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_EOF
    echo "  - Updated GRUB defaults"
fi

# ============================================================================
# 3. Live ISO Branding
# ============================================================================

echo "[+] Applying live ISO branding..."

# Create /etc/issue with custom branding
cat > /etc/issue << 'ISSUE_EOF'
{{ kiwi_image_description }}
Version: {{ kiwi_image_version }}

Welcome to the Live ISO environment!

ISSUE_EOF

# Create /etc/motd
cat > /etc/motd << 'MOTD_EOF'
================================================================================
{{ kiwi_image_description }}
Version: {{ kiwi_image_version }}
================================================================================

This is a live ISO environment. Changes made to the system will not persist
after reboot unless you install to disk.

{% if kiwi_enable_nvidia %}
NVIDIA Driver Notes:
- First boot may take 2-5 minutes while akmods compiles NVIDIA drivers
- Check driver status: lsmod | grep nvidia
- Verify GPU: nvidia-smi

{% endif %}
{% if kiwi_enable_oneapi %}
Intel oneAPI:
- Environment: source /opt/intel/oneapi/setvars.sh
- Compiler: icx --version

{% endif %}
{% if kiwi_enable_sway %}
Sway Window Manager:
- Select "Sway" from GDM session menu
- Default config: ~/.config/sway/config

{% endif %}
Container Runtime:
- Podman: podman run hello-world
{% if kiwi_enable_nvidia %}
- GPU containers: podman run --device nvidia.com/gpu=all ubuntu nvidia-smi
{% endif %}

For more information, visit the documentation.
================================================================================
MOTD_EOF

echo "  - Created custom /etc/issue and /etc/motd"

# ============================================================================
# 4. Desktop Environment Customization
# ============================================================================

{% if kiwi_enable_gnome %}
echo "[+] Customizing GNOME environment..."

# Create GDM dconf profile for auto-login on live ISO (optional)
# Uncomment below to enable auto-login
# mkdir -p /etc/dconf/profile
# cat > /etc/dconf/profile/gdm << 'GDM_DCONF_EOF'
# user-db:user
# system-db:gdm
# file-db:/usr/share/gdm/greeter-dconf-defaults
# GDM_DCONF_EOF

# Set GNOME default favorites in taskbar
mkdir -p /etc/dconf/db/local.d
cat > /etc/dconf/db/local.d/00-favorite-apps << 'FAVORITES_EOF'
[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'firefox.desktop', 'org.gnome.Software.desktop']
FAVORITES_EOF

dconf update || true
echo "  - Configured GNOME default favorites"
{% endif %}

# ============================================================================
# 5. Documentation and Help Files
# ============================================================================

echo "[+] Installing documentation..."

# Create README in user home directory
mkdir -p /etc/skel/
cat > /etc/skel/README.txt << 'README_EOF'
{{ kiwi_image_description }}
==============================================================================

WELCOME TO YOUR AI/HPC WORKSTATION LIVE ISO

This image includes:
{% if kiwi_enable_gnome %}
  - GNOME 49 Desktop Environment
{% endif %}
{% if kiwi_enable_sway %}
  - Sway Tiling Window Manager
{% endif %}
{% if kiwi_enable_nvidia %}
  - NVIDIA Proprietary Drivers (akmods)
  - NVIDIA Container Toolkit
{% endif %}
{% if kiwi_enable_oneapi %}
  - Intel oneAPI Compiler Suite
  - Intel Math Kernel Library (MKL)
{% endif %}
  - Podman Container Runtime
  - Development Tools

FIRST BOOT:
{% if kiwi_enable_nvidia %}
The first boot may take 2-5 minutes while the NVIDIA kernel modules are
compiled by akmods. You may see a black screen during this time - this is
normal. Be patient!

After boot completes, verify NVIDIA driver:
  $ lsmod | grep nvidia
  $ nvidia-smi
{% endif %}

QUICK START:
{% if kiwi_enable_sway %}
1. Try Sway: Select "Sway" from the GDM session menu
{% endif %}
2. Run containers: podman run hello-world
{% if kiwi_enable_nvidia %}
3. Test GPU: podman run --rm --device nvidia.com/gpu=all ubuntu nvidia-smi
{% endif %}
{% if kiwi_enable_oneapi %}
4. Use Intel compilers: source /opt/intel/oneapi/setvars.sh && icx --version
{% endif %}

INSTALLATION:
To install this system permanently, use Anaconda installer from Applications
menu or run: sudo liveinst

SUPPORT:
For issues and documentation, visit:
  https://github.com/your-org/your-repo

==============================================================================
README_EOF

echo "  - Created user README"

# ============================================================================
# 6. Filesystem Optimizations
# ============================================================================

echo "[+] Applying filesystem optimizations..."

# Trim filesystem to reduce ISO size
fstrim -v / || true

# ============================================================================
# 7. Security Hardening
# ============================================================================

echo "[+] Applying security configurations..."

# Set appropriate permissions on sensitive files
chmod 600 /etc/ssh/ssh_host_*_key 2>/dev/null || true
chmod 644 /etc/ssh/ssh_host_*_key.pub 2>/dev/null || true

# Disable root password login for live ISO
passwd -l root || true

# ============================================================================
# 8. Performance Tuning
# ============================================================================

echo "[+] Applying performance tuning..."

# Configure systemd for faster boot
mkdir -p /etc/systemd/system.conf.d
cat > /etc/systemd/system.conf.d/10-timeout.conf << 'SYSTEMD_EOF'
[Manager]
DefaultTimeoutStartSec=30s
DefaultTimeoutStopSec=15s
SYSTEMD_EOF

echo "  - Configured systemd timeout optimizations"

# ============================================================================
# Final Cleanup
# ============================================================================

echo "[+] Performing final image cleanup..."

# Remove any temporary files
find /tmp -type f -delete 2>/dev/null || true
find /var/tmp -type f -delete 2>/dev/null || true

# Clear log files
find /var/log -type f -exec truncate -s 0 {} \; 2>/dev/null || true

# Remove DHCP leases
rm -f /var/lib/dhcp/* 2>/dev/null || true

# Clear bash history for the build
history -c || true
rm -f /root/.bash_history 2>/dev/null || true

echo "============================================================================"
echo "Image Customization Complete"
echo "============================================================================"

exit 0
