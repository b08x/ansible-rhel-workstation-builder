#!/bin/bash
# ============================================================================
# config.sh - KIWI Chroot Configuration Script
# ============================================================================
# This script executes inside the chroot environment during KIWI's 'prepare' phase
# Generated by Ansible kiwi role
# Ansible managed - DO NOT EDIT MANUALLY
# ============================================================================

set -x

# Source KIWI environment
if [ -f /.kconfig ]; then
    . /.kconfig
fi

if [ -f /.profile ]; then
    . /.profile
fi

echo "============================================================================"
echo "KIWI Post-Installation Configuration"
echo "Image: {{ kiwi_image_name }}"
echo "Version: {{ kiwi_image_version }}"
echo "============================================================================"

# ============================================================================
# 1. System Service Configuration
# ============================================================================

echo "[+] Configuring system services..."

# Enable essential services
{% for service in kiwi_enabled_services %}
echo "  - Enabling {{ service }}"
baseInsertService {{ service }}
{% endfor %}

{% if kiwi_enable_nvidia %}
# Enable NVIDIA-specific services for akmods and CDI
echo "[+] Enabling NVIDIA driver services..."
{% for service in kiwi_nvidia_services %}
echo "  - Enabling {{ service }}"
baseInsertService {{ service }}
{% endfor %}
{% endif %}

# ============================================================================
# 2. Display Manager Configuration
# ============================================================================

{% if kiwi_enable_gnome %}
echo "[+] Configuring GDM (GNOME Display Manager)..."

# Ensure GDM is enabled
baseInsertService gdm

# Configure GDM for Wayland
if [ -f /etc/gdm/custom.conf ]; then
    # Enable Wayland by default
    sed -i 's/#WaylandEnable=false/WaylandEnable=true/' /etc/gdm/custom.conf
fi
{% endif %}

# ============================================================================
# 3. Intel oneAPI Environment Configuration
# ============================================================================

{% if kiwi_enable_oneapi %}
echo "[+] Configuring Intel oneAPI environment..."

# Create system-wide oneAPI initialization script
cat << 'ONEAPI_EOF' > /etc/profile.d/oneapi.sh
# Intel oneAPI Environment Configuration
# Automatically source oneAPI environment variables

if [ -f /opt/intel/oneapi/setvars.sh ]; then
    # Quiet mode - suppress output during login
    source /opt/intel/oneapi/setvars.sh --quiet > /dev/null 2>&1 || true
fi
ONEAPI_EOF

chmod 644 /etc/profile.d/oneapi.sh
echo "  - Created /etc/profile.d/oneapi.sh"

# Create module environment for Intel compilers
mkdir -p /etc/modulefiles/intel
cat << 'MODULE_EOF' > /etc/modulefiles/intel/oneapi
#%Module1.0
##
## Intel oneAPI module file
##
proc ModulesHelp { } {
    puts stderr "Intel oneAPI Compiler Suite"
}

module-whatis "Intel oneAPI Compiler Suite"

if { [file exists /opt/intel/oneapi/setvars.sh] } {
    set-function setvars {source /opt/intel/oneapi/setvars.sh}
}
MODULE_EOF

echo "  - Created module file for Intel oneAPI"
{% endif %}

# ============================================================================
# 4. Sway Window Manager Configuration
# ============================================================================

{% if kiwi_enable_sway %}
echo "[+] Configuring Sway window manager..."

# Register Sway as a Wayland session for GDM
if [ ! -f /usr/share/wayland-sessions/sway.desktop ]; then
    mkdir -p /usr/share/wayland-sessions
    cat << 'SWAY_EOF' > /usr/share/wayland-sessions/sway.desktop
[Desktop Entry]
Name=Sway
Comment=An i3-compatible Wayland compositor
Exec=sway
Type=Application
DesktopNames=sway
SWAY_EOF
    echo "  - Created Sway Wayland session descriptor"
fi

# Create default Sway config for new users
mkdir -p /etc/skel/.config/sway
if [ -f /etc/sway/config ]; then
    cp /etc/sway/config /etc/skel/.config/sway/config
    echo "  - Installed default Sway config for new users"
fi
{% endif %}

# ============================================================================
# 5. NVIDIA Driver Configuration
# ============================================================================

{% if kiwi_enable_nvidia %}
echo "[+] Configuring NVIDIA driver infrastructure..."

# Create modprobe configuration to blacklist nouveau
cat << 'NVIDIA_MODPROBE_EOF' > /etc/modprobe.d/blacklist-nouveau.conf
# Blacklist nouveau driver in favor of NVIDIA proprietary driver
blacklist nouveau
options nouveau modeset=0
NVIDIA_MODPROBE_EOF

echo "  - Created /etc/modprobe.d/blacklist-nouveau.conf"

# Configure nvidia-container-toolkit for Podman
if [ -x /usr/bin/nvidia-ctk ]; then
    echo "  - Configuring NVIDIA Container Toolkit for Podman..."
    # Generate CDI specification
    nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml || true
    echo "  - Generated NVIDIA CDI specification"
fi

# Create systemd service to refresh NVIDIA CDI on boot
cat << 'NVIDIA_SERVICE_EOF' > /etc/systemd/system/nvidia-cdi-refresh.service
[Unit]
Description=Refresh NVIDIA Container Device Interface (CDI) specification
After=akmods.service
ConditionPathExists=/usr/bin/nvidia-ctk

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
NVIDIA_SERVICE_EOF

echo "  - Created nvidia-cdi-refresh.service"
{% endif %}

# ============================================================================
# 6. GPG Key Import
# ============================================================================

echo "[+] Importing RPM GPG keys..."

# Import Fedora GPG key
if [ -f /etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-{{ fedora_version }}-primary ]; then
    rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-{{ fedora_version }}-primary
    echo "  - Imported Fedora {{ fedora_version }} GPG key"
fi

# Import RPM Fusion GPG keys
for key in /etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-*; do
    if [ -f "$key" ]; then
        rpm --import "$key"
        echo "  - Imported $(basename $key)"
    fi
done

# ============================================================================
# 7. DNF Performance Optimization
# ============================================================================

echo "[+] Optimizing DNF configuration..."

cat >> /etc/dnf/dnf.conf << 'DNF_EOF'

# Performance optimizations
{% if kiwi_dnf_fastestmirror %}
fastestmirror=True
{% endif %}
max_parallel_downloads={{ kiwi_dnf_max_parallel_downloads }}
{% if kiwi_dnf_clean_requirements_on_remove %}
clean_requirements_on_remove=True
{% endif %}

# Keep cache for faster reinstalls
keepcache=True

# Skip weak dependencies to reduce size
install_weak_deps=False
DNF_EOF

echo "  - Updated /etc/dnf/dnf.conf with performance settings"

# ============================================================================
# 8. Firewall Configuration
# ============================================================================

echo "[+] Configuring firewall..."

# Enable firewalld
baseInsertService firewalld

# Configure default zone
if command -v firewall-offline-cmd &> /dev/null; then
    firewall-offline-cmd --set-default-zone=public
    echo "  - Set default firewall zone to 'public'"
fi

# ============================================================================
# 9. User Environment Setup
# ============================================================================

echo "[+] Configuring default user environment..."

# Create default user home directory structure
mkdir -p /home/{{ kiwi_default_user }}/{Downloads,Documents,Pictures,Videos,Music}
chown -R {{ kiwi_default_user }}:{{ kiwi_default_user }} /home/{{ kiwi_default_user }} || true

# Set bash as default shell
chsh -s /bin/bash {{ kiwi_default_user }} || true

# ============================================================================
# 10. System Tuning
# ============================================================================

echo "[+] Applying system tuning..."

# Disable automatic system updates (for live ISO)
systemctl disable dnf-automatic.timer || true
systemctl disable dnf-makecache.timer || true

# Reduce boot timeout for faster startup
if [ -f /etc/default/grub ]; then
    sed -i 's/GRUB_TIMEOUT=.*/GRUB_TIMEOUT={{ kiwi_bootloader_timeout }}/' /etc/default/grub
fi

# ============================================================================
# 11. Container Runtime Configuration
# ============================================================================

echo "[+] Configuring container runtime..."

# Configure Podman for rootless mode
cat >> /etc/containers/containers.conf << 'CONTAINER_EOF'

# Enable cgroup v2 support
[engine]
cgroup_manager = "systemd"
events_logger = "journald"

# Network configuration
[network]
network_backend = "netavark"
CONTAINER_EOF

echo "  - Updated Podman configuration"

# ============================================================================
# 12. Locale Generation
# ============================================================================

echo "[+] Ensuring locale is generated..."

# Generate en_US.UTF-8 locale
localedef -i en_US -f UTF-8 en_US.UTF-8 || true

# ============================================================================
# 13. yadm Installation
# ============================================================================
dnf config-manager addrepo --from-repofile=https://download.opensuse.org/repositories/home:TheLocehiliosan:yadm/Fedora_43/home:TheLocehiliosan:yadm.repo
dnf install yadm

# ============================================================================
# Cleanup and Final Steps
# ============================================================================

echo "[+] Performing final cleanup..."

# Clean DNF cache to reduce image size
dnf clean all || true

# Remove temporary files
rm -rf /tmp/* /var/tmp/* || true

# Clear machine-id (will be regenerated on first boot)
truncate -s 0 /etc/machine-id || true

echo "============================================================================"
echo "KIWI Configuration Complete"
echo "============================================================================"

exit 0
