<?xml version="1.0" encoding="utf-8"?>
<!-- KIWI Image Description: {{ kiwi_image_name }} -->
<!-- Generated by Ansible kiwi role -->
<!-- Ansible managed - DO NOT EDIT MANUALLY -->

<image schemaversion="7.4" name="{{ kiwi_image_name }}">
    <!-- ================================================================ -->
    <!-- Image Description -->
    <!-- ================================================================ -->
    <description type="system">
        <author>Platform Engineering</author>
        <contact>maintainer@example.com</contact>
        <specification>{{ kiwi_image_description }}</specification>
    </description>

    <!-- ================================================================ -->
    <!-- Global Preferences -->
    <!-- ================================================================ -->
    <preferences>
        <version>{{ kiwi_image_version }}</version>
        <packagemanager>dnf5</packagemanager>
        <locale>{{ kiwi_locale }}</locale>
        <keytable>{{ kiwi_keytable }}</keytable>
        <timezone>{{ kiwi_timezone }}</timezone>
        <rpm-excludedocs>true</rpm-excludedocs>
        <rpm-check-signatures>{{ kiwi_rpm_check_signatures | lower }}</rpm-check-signatures>
        <bootsplash-theme>charge</bootsplash-theme>
    </preferences>

    <!-- ================================================================ -->
    <!-- Image Type: Live ISO -->
    <!-- ================================================================ -->
    <preferences>
        <type
            image="iso"
            primary="true"
            flags="{{ kiwi_image_flags }}"
            hybrid="{{ kiwi_iso_hybrid | lower }}"
            firmware="{{ kiwi_firmware }}"
            mediacheck="true"
            publisher="Platform Engineering"
            volid="{{ iso_label }}">
            <bootloader
                name="{{ kiwi_bootloader }}"
                timeout="{{ kiwi_bootloader_timeout }}"
                console="{{ kiwi_bootloader_console }}">
                <cmdline>{{ kiwi_kernel_cmdline }}</cmdline>
            </bootloader>
            <size unit="G">{{ kiwi_root_size_gb }}</size>
        </type>
    </preferences>

    <!-- ================================================================ -->
    <!-- Users Configuration -->
    <!-- ================================================================ -->
    <users>
        <user
            groups="{{ kiwi_default_groups }}"
            name="{{ kiwi_default_user }}"
            password="{{ kiwi_default_password }}"
            home="/home/{{ kiwi_default_user }}"
            shell="/bin/bash"/>
    </users>

    <!-- ================================================================ -->
    <!-- Repository Configuration -->
    <!-- ================================================================ -->

    <!-- Fedora Base Repository -->
    <repository type="rpm-md" alias="fedora" priority="50">
        <source path="{{ fedora_base_url }}"/>
    </repository>

    <!-- Fedora Updates Repository -->
    <repository type="rpm-md" alias="updates" priority="40">
        <source path="{{ fedora_updates_url }}"/>
    </repository>

    <!-- RPM Fusion Free Repository -->
    <repository type="rpm-md" alias="rpmfusion-free" priority="60">
        <source path="{{ rpmfusion_free_url }}"/>
    </repository>

    <!-- RPM Fusion Nonfree Repository -->
    <repository type="rpm-md" alias="rpmfusion-nonfree" priority="60">
        <source path="{{ rpmfusion_nonfree_url }}"/>
    </repository>

{% if kiwi_enable_nvidia %}
    <!-- NVIDIA Container Toolkit Repository -->
    <repository type="rpm-md" alias="nvidia-container-toolkit" priority="70" package_gpgcheck="false">
        <source path="{{ nvidia_container_url }}"/>
    </repository>
{% endif %}

{% if kiwi_enable_oneapi %}
    <!-- Intel oneAPI Repository -->
    <repository type="rpm-md" alias="oneAPI" priority="70" package_gpgcheck="false">
        <source path="{{ intel_oneapi_url }}"/>
    </repository>
{% endif %}

    <!-- ================================================================ -->
    <!-- Package Selection: Core System -->
    <!-- ================================================================ -->
    <packages type="image">
        <!-- Core Packages -->
{% for package in kiwi_core_packages %}
        <package name="{{ package }}"/>
{% endfor %}

        <!-- GNOME Workstation Environment -->
{% if kiwi_enable_gnome %}
        <!-- Use named collection for full Workstation experience -->
        <namedCollection name="workstation-product-environment"/>

        <!-- Additional GNOME packages -->
{% for package in kiwi_gnome_packages %}
        <package name="{{ package }}"/>
{% endfor %}
{% endif %}

        <!-- Sway Tiling Window Manager -->
{% if kiwi_enable_sway %}
{% for package in kiwi_sway_packages %}
        <package name="{{ package }}"/>
{% endfor %}
{% endif %}

        <!-- NVIDIA Driver Stack (Akmods) -->
{% if kiwi_enable_nvidia %}
{% for package in kiwi_nvidia_packages %}
        <package name="{{ package }}"/>
{% endfor %}
{% endif %}

        <!-- Container Runtime -->
{% for package in kiwi_container_packages %}
        <package name="{{ package }}"/>
{% endfor %}

{% if kiwi_enable_nvidia %}
        <!-- NVIDIA Container Toolkit -->
        <package name="nvidia-container-toolkit"/>
{% endif %}

        <!-- Intel oneAPI Toolchain -->
{% if kiwi_enable_oneapi %}
{% for package in kiwi_oneapi_packages %}
        <package name="{{ package }}"/>
{% endfor %}
{% endif %}

        <!-- Development Tools -->
{% for package in kiwi_devel_packages %}
        <package name="{{ package }}"/>
{% endfor %}
    </packages>

    <!-- ================================================================ -->
    <!-- Packages to Remove (Strip down for size optimization) -->
    <!-- ================================================================ -->
    <packages type="delete">
        <!-- Remove documentation to save space -->
        <package name="man-db"/>
        <package name="man-pages"/>

        <!-- Remove unnecessary input method frameworks -->
        <package name="ibus"/>

        <!-- Remove legacy/unused packages -->
        <package name="sendmail"/>
    </packages>

    <!-- ================================================================ -->
    <!-- Bootstrap Packages (Required for chroot environment) -->
    <!-- ================================================================ -->
    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="glibc-all-langpacks"/>
        <package name="fedora-release"/>
        <package name="basesystem"/>
    </packages>
</image>
